# MIG-STRAT-02: feature flags. Откат = изменить на 'false' и пересобрать.
VITE_FEATURE_DIAGRAM=true
VITE_FEATURE_STAMP_EDITOR=true
VITE_FEATURE_NEW_LEFT_PANEL=true
VITE_FEATURE_NEW_CANVAS=false

# MIG-UI-01/02: banner + rollback-кнопка на время rollout.
VITE_FEATURE_SHOW_MIGRATION_BANNER=true
VITE_FEATURE_SHOW_ROLLBACK_BUTTON=true

# NFR-OBS-02: Sentry DSN (только prod)
VITE_SENTRY_DSN=

# NFR-SEC-08: URL из env
VITE_DRAWIO_URL=https://embed.diagrams.net/
VITE_EXPORT_API=http://localhost:8080/api/export